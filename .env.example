# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_BIN=claude
CC_MODEL=sonnet
JUDGE_MODEL=claude-sonnet-4-6
MAX_TURNS=40
MAX_ATTEMPTS=4

# --- Бюджет (жёсткий стоп на сутки) ---
DAILY_BUDGET_USD=25

# --- Параллелизм ---
LANE_CHAT=8
LANE_BUILD=3
LANE_VERIFY=2

# --- Google Sheets ---
SHEET_ID=1AbC...
SHEET_TAB=Заказы
GOOGLE_CREDS=./service_account.json
SHEET_SYNC_SEC=60

# --- Telegram (нужен Premium у владельца + Business Mode у бота в @BotFather) ---
TG_BOT_TOKEN=
# владелец — техчасть: доступы, ключи, технические уточнения
TG_OWNER_CHAT_ID=
# менеджер — деньги, сроки, объём, претензии. Сюда уходит всё спорное
TG_MANAGER_CHAT_ID=
# long polling getUpdates, секунд
TG_POLL_TIMEOUT=25

# --- Приёмка ---
# 1 = без ANTHROPIC_API_KEY llm-проверка просто пропускается,
# по умолчанию (пусто) — она считается непройденной
JUDGE_OPTIONAL=
# цены судьи за миллион токенов, нужны чтобы приёмка попадала в суточный бюджет
JUDGE_PRICE_IN_USD_PER_MTOK=3
JUDGE_PRICE_OUT_USD_PER_MTOK=15

# --- Тихие часы отправки (локальное время; равные значения = слать всегда) ---
QUIET_START=23
QUIET_END=9

# --- Прочее ---
TASK_TIMEOUT_SEC=1800
# 1 = заглушки вместо Claude Code и судьи (посмотреть на планировщик, ничего не потратив)
DRY_RUN=

# --- Хранилище секретов ---
# ключ Fernet: сгенерировать `python scripts/vault_cli.py genkey`
VAULT_KEY=
# файл с шифрованными секретами, ДОЛЖЕН лежать вне репозитория
VAULT_PATH=./secrets.enc

# --- Сообщения и справедливость ---
# клиенту уходит не больше одного отчёта о готовности за это окно, минут
AGGREGATE_WINDOW_MIN=60
# период полураспада счётчика WFQ, часов
SERVED_HALFLIFE_H=24
# как часто можно напоминать клиенту про недостающие доступы, часов
ACCESS_REMINDER_H=24

# --- MAX ---
# ВНИМАНИЕ: с августа 2025 боты в MAX доступны только верифицированным
# юрлицам РФ. Без верификации токен не выдадут — это внешняя блокировка.
MAX_TOKEN=
MAX_API_BASE=https://platform-api.max.ru
MAX_POLL_TIMEOUT=30
# polling (локально) | webhook (сервер). Одновременно работает только один
MAX_MODE=polling
MAX_WEBHOOK_URL=

# 0 = не поднимать поллеры мессенджеров вообще
INGEST_ENABLED=1
