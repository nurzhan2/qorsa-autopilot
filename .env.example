# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_BIN=claude
CC_MODEL=sonnet
JUDGE_MODEL=claude-sonnet-4-6
MAX_TURNS=40
MAX_ATTEMPTS=4

# --- Бюджет (жёсткий стоп на сутки) ---
DAILY_BUDGET_USD=25

# --- Параллелизм ---
LANE_CHAT=8
LANE_BUILD=3
LANE_VERIFY=2

# --- Google Sheets ---
SHEET_ID=1AbC...
SHEET_TAB=Заказы
GOOGLE_CREDS=./service_account.json
SHEET_SYNC_SEC=60

# --- Telegram (пока заглушка) ---
TG_BOT_TOKEN=
TG_OWNER_CHAT_ID=

# --- Приёмка ---
# 1 = без ANTHROPIC_API_KEY llm-проверка просто пропускается,
# по умолчанию (пусто) — она считается непройденной
JUDGE_OPTIONAL=
# цены судьи за миллион токенов, нужны чтобы приёмка попадала в суточный бюджет
JUDGE_PRICE_IN_USD_PER_MTOK=3
JUDGE_PRICE_OUT_USD_PER_MTOK=15

# --- Тихие часы отправки (локальное время; равные значения = слать всегда) ---
QUIET_START=23
QUIET_END=9

# --- Прочее ---
TASK_TIMEOUT_SEC=1800
# 1 = заглушки вместо Claude Code и судьи (посмотреть на планировщик, ничего не потратив)
DRY_RUN=
