+function verifyWebhookSignature(req) {
+  const received = req.headers['x-yookassa-signature'];
+  const expected = crypto
+    .createHmac('sha256', process.env.YOOKASSA_WEBHOOK_SECRET)
+    .update(JSON.stringify(req.body))
+    .digest('hex');
+  return received === expected;
+}
+
+router.post('/payments/webhook', async (req, res) => {
+  if (!verifyWebhookSignature(req)) {
+    return res.status(403).json({ error: 'bad signature' });
+  }
+
+  const event = req.body;
+  if (event.event === 'payment.succeeded') {
+    const orderId = event.object.metadata.order_id;
+    await Order.update({ status: 'paid', paid_at: new Date() }, { where: { id: orderId } });
+  }
+
+  res.json({ ok: true });
+});
+
 module.exports = router;
