# Компании владельца. Четвёртая добавляется дописанным блоком [[account]],
# правок кода не требуется.
#
# ТОКЕНОВ ЗДЕСЬ НЕТ: bot_token_ref / max_token_ref — ИМЕНА секретов в vault.
#     python scripts/vault_cli.py add QORSA_BOT_TOKEN
#
# code — ключ, он не совпадает с названием мессенджера НИКОГДА (код это
# запрещает). display_name — как компанию зовут люди. sheet_alias — что
# может стоять в колонке «Компания» и означать её же.
#
# Таблица одна общая на все компании: строку к компании привязывает
# колонка «Компания». Пустая или незнакомая ячейка — не догадка,
# а вопрос владельцу.

[[account]]
code = "qorsa"
name = "Qorsa Studio"
display_name = "Qorsa Studio"
sheet_alias = ["qorsa", "Qorsa", "Корса"]
transport = "telegram"
handle = "@qorsastudio"
owner_tg_id = ""            # id владельца в чатах этой компании
bot_token_ref = "QORSA_BOT_TOKEN"
sheet_id = ""
sheet_tab = "Заказы"
signature = "Qorsa Studio"
active = true

[[account]]
code = "hustle"
name = "Hustle Design"
display_name = "Hustle Design"
sheet_alias = ["hustle", "Hustle", "Хасл"]
transport = "telegram"
handle = "@hustle_design"
owner_tg_id = ""            # id владельца в чатах этой компании
bot_token_ref = "HUSTLE_BOT_TOKEN"
sheet_id = ""
sheet_tab = "Заказы"
signature = "Hustle Design"
active = true

# Компания называется MAX и работает в мессенджере MAX. Код НАМЕРЕННО другой:
# «max» — это транспорт, и совпадение сделало бы пару (компания, транспорт)
# неразличимой на глаз. В таблице и в общении она остаётся «MAX».
#
# active = false: токена нет и взять его негде — MAX пускает на платформу
# только верифицированные юрлица РФ. Это внешняя блокировка на стороне
# владельца, а не недоделка в коде. Ниже плейсхолдеры: заполнить, когда
# верификация пройдёт, и переключить active.
[[account]]
code = "maxru"
name = "MAX"
display_name = "MAX"
sheet_alias = ["max", "МАКС", "Max", "макс"]
transport = "max"
handle = ""
owner_max_id = ""                  # id владельца в MAX — дать позже
bot_max_id = ""
max_token_ref = "MAXRU_MAX_TOKEN"  # секрет заведём, когда будет токен
sheet_id = ""
sheet_tab = "Заказы"
signature = "MAX"
active = false
